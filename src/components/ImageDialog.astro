<dialog class="image-dialog" aria-labelledby="image-dialog-title" id="image-dialog">
  <div class="reader-toolbar">
    <h2 id="image-dialog-title">查看大图</h2>
    <div class="reader-actions">
      <select class="image-zoom" id="image-zoom" aria-label="图片缩放">
        <option value="fit">适合窗口</option>
        <option value="detail">放大查看</option>
        <option value="original">原尺寸</option>
      </select>
      <button type="button" id="close-image" aria-label="关闭大图">
        <img src="/assets/x.svg" width="24" height="24" alt="" />
      </button>
    </div>
  </div>
  <div class="image-dialog-content" role="region" tabindex="0" aria-label="大图预览">
    <img id="image-dialog-picture" alt="" hidden />
  </div>
</dialog>

<script>
  import "../scripts/image-dialog";
</script>
