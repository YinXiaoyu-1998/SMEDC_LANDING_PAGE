---
import animationSource from "../../animation/index.html?raw";
import "../../animation/setup.css";

const markup =
  animationSource.split("<!-- setup-demo:start -->")[1]?.split("<!-- setup-demo:end -->")[0] ?? "";
---

<figure class="setup-demo-block" aria-labelledby="setup-demo-title">
  <div class="setup-demo-heading">
    <h3 id="setup-demo-title">安装与配置演示</h3>
    <button type="button" id="copy-setup-prompt" class="setup-copy-button" hidden>
      复制安装请求
    </button>
  </div>
  <Fragment set:html={markup} />
  <p class="visually-hidden">
    向您使用的智能体发送安装请求。智能体核对环境、安装配套技能并配置 MCP 连接。
  </p>
  <div class="setup-demo-footer" data-demo-playback hidden>
    <div class="setup-demo-controls">
      <button type="button" id="setup-play">
        播放演示
      </button>
      <input
        id="setup-progress"
        type="range"
        min="0"
        max="18"
        step="0.1"
        value="18"
        aria-label="安装演示进度"
      />
    </div>
  </div>
  <p class="setup-demo-status" id="setup-demo-status" role="status" aria-live="polite"></p>
</figure>

<script>
  import "../scripts/setup-demo";
</script>
