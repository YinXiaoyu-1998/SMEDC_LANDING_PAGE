---
import type { AgentExample } from "../content/features";

interface Props {
  example: AgentExample;
}

const { example } = Astro.props;
---

<figure class="agent-example">
  <figcaption>
    <span>Agent 使用示例</span>
    <strong>{example.caption}</strong>
  </figcaption>
  <div class="agent-example-thread">
    <p class="agent-example-question">{example.question}</p>
    <p class="agent-example-answer">
      <span>Agent</span>
      {example.answer}
    </p>
    {example.source && <p class="agent-example-source">{example.source}</p>}
  </div>
</figure>
