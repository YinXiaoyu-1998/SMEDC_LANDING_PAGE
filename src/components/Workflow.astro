<section class="section workflow" id="workflow" aria-labelledby="workflow-title">
  <div class="container workflow-grid">
    <div class="section-lead" data-reveal>
      <h2 id="workflow-title">接入方式</h2>
    </div>
    <div class="service-choices" data-reveal>
      <details class="service-choice" name="service-mode">
        <summary>
          <span>
            <strong>自行接入</strong>
            <span class="choice-description">用您常用的兼容智能体接入企业智脑。</span>
          </span>
          <img
            class="icon choice-arrow"
            src="/assets/arrow-up-right.svg"
            alt=""
            width="24"
            height="24"
          />
        </summary>
        <div class="choice-content">
          <a class="text-link" href="#integrations">
            查看接入方法
            <img class="icon" src="/assets/arrow-down.svg" alt="" width="18" height="18" />
          </a>
        </div>
      </details>
      <details class="service-choice" name="service-mode">
        <summary>
          <span>
            <strong>开发者协助接入</strong>
            <span class="choice-description">协助接入数据、配置自动任务和日常维护。</span>
          </span>
          <img
            class="icon choice-arrow"
            src="/assets/arrow-up-right.svg"
            alt=""
            width="24"
            height="24"
          />
        </summary>
        <div class="choice-content">
          <a class="text-link" href="#contact">
            联系我们
            <img class="icon" src="/assets/arrow-up-right.svg" alt="" width="18" height="18" />
          </a>
        </div>
      </details>
    </div>
  </div>
</section>
