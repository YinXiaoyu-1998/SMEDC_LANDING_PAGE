---
import { cases, automaticReply } from "../content/story";
interface Props {
  scene: number;
}
const { scene } = Astro.props;
const item = cases[scene];
---

{item ? (
  <div class="story-result">
    <header>
      <span>{item.label}</span>
      <span>经营建议</span>
    </header>
    <div class="slip-key">
      {item.prefix} <strong>{item.value}</strong> {item.unit}
    </div>
    <p>{item.summary}</p>
    <footer>
      {item.id === "beef" ? "收档盘点后，按实存调整订量。" : "优先复核午市新增的 8 个工时。"}
    </footer>
  </div>
) : (
  <div class="story-result review-slip">
    <header>
      <span>AI 自动回复</span>
      <span>常营天街店</span>
    </header>
    <blockquote>周末和朋友聚餐，吃烤串时还能配上酒喝一杯</blockquote>
    <p>{automaticReply.split("！")[0]}！</p>
    <footer>本轮自动回复 · 节选</footer>
  </div>
)}
