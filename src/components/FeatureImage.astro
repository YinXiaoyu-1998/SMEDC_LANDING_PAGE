---
import { reportSample, type FeatureImage } from "../content/features";
import { dimensions } from "../content/feature-image-dimensions";

interface Props {
  visual: FeatureImage;
}

const { visual } = Astro.props;
const preview = visual.preview ?? visual.file;
const [width, height] = dimensions[preview];
const report = Boolean(visual.reportRoute);
const href = report ? reportSample.url + visual.reportRoute : "/assets/" + visual.file;
---

<figure class="feature-image">
  <a
    {href}
    data-open-report={report || undefined}
    data-open-image={report ? undefined : visual.caption}
    aria-label={report ? "查看周报：" + visual.caption : "查看大图：" + visual.caption}
  >
    <img
      src={"/assets/" + preview}
      alt={visual.alt}
      {width}
      {height}
      loading="lazy"
      decoding="async"
    />
  </a>
  <figcaption>
    <span>{visual.caption}</span>
    {!report && (
      <span class="feature-image-action" aria-hidden="true">
        查看大图
      </span>
    )}
  </figcaption>
</figure>
