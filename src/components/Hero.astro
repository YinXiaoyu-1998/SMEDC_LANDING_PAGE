---
import { reportSample } from "../content/features";
---

<section class="hero" aria-labelledby="hero-title">
  <img
    class="hero-photo"
    src="/assets/hero.webp"
    alt="晚间营业的西北餐馆里，厨师在炉火与蒸汽间准备出餐。"
    width="1619"
    height="971"
    fetchpriority="high"
  />
  <div class="container hero-inner">
    <div class="hero-copy">
      <h1 id="hero-title" data-entrance>
        企业智脑
      </h1>
      <p class="hero-description" data-entrance>
        汇集门店经营资料，支持<span>经营分析</span>、<span>巡检填报</span>、<span>收货台账</span>和
        <span>经营周报</span>。
      </p>
      <div class="hero-actions" data-entrance>
        <a class="button" href="#features">
          浏览全部功能
          <img class="icon" src="/assets/arrow-down.svg" alt="" width="20" height="20" />
        </a>
        <a class="text-link text-link-light" href={reportSample.url} data-open-report>
          读一份完整周报
        </a>
      </div>
    </div>
  </div>
</section>
