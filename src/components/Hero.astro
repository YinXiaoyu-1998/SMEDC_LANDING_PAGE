---
import { reportSample } from "../content/features";
import { scenes } from "../content/story";
import StoryResult from "./StoryResult.astro";
---

<section class="story-hero" aria-labelledby="hero-title">
  <img
    class="kitchen-light"
    src="/assets/hero.webp"
    alt=""
    width="1619"
    height="971"
    fetchpriority="high"
  />
  <div class="container opening-grid">
    <div class="opening-copy">
      <h1 id="hero-title" data-entrance>
        让你的智能体，
        <br />
        读懂<span>门店生意。</span>
      </h1>
      <p data-entrance>企业智脑归集门店资料。用你自己的智能体查数据、核单据，复盘每一天的生意。</p>
      <div class="opening-links" data-entrance>
        <a class="story-cta" href="#combined-work">
          看它怎么算 <span aria-hidden="true">↓</span>
        </a>
        <a class="story-link" href={reportSample.url} data-open-report>
          读一份完整周报
        </a>
      </div>
    </div>
    <div class="agent-stage" role="region" aria-label="员工智能体演示">
      <div class="stage-caption">
        <span class="status-dot"></span>员工智能体演示 <span>／ 示例数据</span>
      </div>
      <div class="result-stack">
        {scenes.map((_, i) => (
          <div class="result-frame" hidden={i !== 0}>
            <StoryResult scene={i} />
          </div>
        ))}
      </div>
      <div class="prompt-strip" role="group">
        <span class="prompt-text">{scenes[0].question}</span>
        <span class="send-mark" aria-hidden="true">
          ↑
        </span>
      </div>
      <div class="scene-controls" hidden>
        <div class="scene-picker" role="group" aria-label="选择演示场景">
          {scenes.map((scene, i) => (
            <button type="button" data-question={scene.question} aria-pressed={i === 0}>
              {scene.label}
            </button>
          ))}
        </div>
        <button class="playback" type="button" aria-label="暂停场景轮播">
          暂停
        </button>
      </div>
    </div>
  </div>
</section>
<script>
  import "../scripts/story";
</script>
