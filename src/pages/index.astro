---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import StoreScenes from "../components/StoreScenes.astro";
import Features from "../components/Features.astro";
import CombinedWork from "../components/CombinedWork.astro";
import ReportDialog from "../components/ReportDialog.astro";
import ImageDialog from "../components/ImageDialog.astro";
import Workflow from "../components/Workflow.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
import "../styles/features.css";
import "../styles/story.css";
---

<BaseLayout
  title="企业智脑｜生意在店里，功夫在细处"
  description="浏览企业智脑的多店经营周报、巡检、收货台账、顾客评价和总部管理功能，了解如何用智能体组合经营资料。"
  canonical="https://smedatacenter.xyz/"
  ogDescription="查看 12 项门店和总部功能、真实界面和一份完整的多店经营周报。"
>
  <Hero />
  <CombinedWork />
  <StoreScenes />
  <Features />
  <Workflow />
  <Faq />
  <Contact />
  <ReportDialog />
  <ImageDialog />
</BaseLayout>
