{
  "name": "smedc-landing-page",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && tsx scripts/build-animation.ts && tsx scripts/postbuild.ts",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist/marketing",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "astro": "^7.4.5",
    "gsap": "3.14.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.16"
  }
}
